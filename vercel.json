{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.js": { "maxDuration": 300, "memory": 1024 }
  },
  "crons": [{ "path": "/api/cron/daily", "schedule": "0 4 * * *" }],
  "redirects": [
    { "source": "/entrar", "destination": "/app/login", "permanent": true },
    { "source": "/cadastro", "destination": "/app/cadastro", "permanent": true },
    { "source": "/painel", "destination": "/app/dashboard", "permanent": true },
    { "source": "/app", "destination": "/app/dashboard", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__path=:path*" },
    { "source": "/app/login/:id", "destination": "/app/login" },
    { "source": "/app/esqueci-senha", "destination": "/app/esqueci-senha" },
    { "source": "/app/redefinir/:token", "destination": "/app/redefinir" },
    { "source": "/app/confirmar/:token", "destination": "/app/confirmar" },
    { "source": "/app/dashboard/:id", "destination": "/app/dashboard" },
    { "source": "/app/contas/:id/:account", "destination": "/app/conta" },
    { "source": "/app/contas/:id", "destination": "/app/contas" },
    { "source": "/app/pins/:id/novo", "destination": "/app/pin-novo" },
    { "source": "/app/pins/:id/:pin", "destination": "/app/pin" },
    { "source": "/app/pins/:id", "destination": "/app/pins" },
    { "source": "/app/historico/:id", "destination": "/app/historico" },
    { "source": "/app/analises/:id", "destination": "/app/analises" },
    { "source": "/app/configuracoes/:id", "destination": "/app/configuracoes" },
    { "source": "/app/configura%C3%A7%C3%B5es", "destination": "/app/configuracoes" },
    { "source": "/app/configura%C3%A7%C3%B5es/:id", "destination": "/app/configuracoes" },
    { "source": "/app/configurações", "destination": "/app/configuracoes" },
    { "source": "/app/configurações/:id", "destination": "/app/configuracoes" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
