{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/entrar", "destination": "/app/login", "permanent": true },
    { "source": "/cadastro", "destination": "/app/cadastro", "permanent": true },
    { "source": "/painel", "destination": "/app/dashboard", "permanent": true },
    { "source": "/app", "destination": "/app/dashboard", "permanent": false }
  ],
  "rewrites": [
    { "source": "/app/login/:id", "destination": "/app/login" },
    { "source": "/app/dashboard/:id", "destination": "/app/dashboard" },
    { "source": "/app/contas/:id", "destination": "/app/contas" },
    { "source": "/app/pins/:id", "destination": "/app/pins" },
    { "source": "/app/configuracoes/:id", "destination": "/app/configuracoes" },
    { "source": "/app/configura%C3%A7%C3%B5es", "destination": "/app/configuracoes" },
    { "source": "/app/configura%C3%A7%C3%B5es/:id", "destination": "/app/configuracoes" },
    { "source": "/app/configurações", "destination": "/app/configuracoes" },
    { "source": "/app/configurações/:id", "destination": "/app/configuracoes" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
