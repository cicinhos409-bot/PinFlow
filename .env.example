# Copie este arquivo para .env.local e preencha. NUNCA suba o .env.local para o GitHub.
# Na Vercel, cadastre estas variáveis em Project Settings > Environment Variables.

# --- App no portal de desenvolvedores do Pinterest ---
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Tem que ser IDÊNTICO ao cadastrado no app (aba Configure > Redirect URIs)
PINTEREST_REDIRECT_URI=https://SEU-DOMINIO/api/pinterest/callback
# Trial/Standard usam produção; o ambiente de testes usa o sandbox
PINTEREST_API_BASE=https://api.pinterest.com/v5
# PINTEREST_API_BASE=https://api-sandbox.pinterest.com/v5

# --- Segurança ---
# Chave para criptografar os tokens das contas no banco (gerar 32 bytes aleatórios, em base64)
TOKEN_ENCRYPTION_KEY=
# Segredo para assinar sessões/cookies de login
SESSION_SECRET=

# --- Banco de dados (a definir) ---
# Preencha quando escolher o banco. Ver docs/banco-de-dados/
DATABASE_URL=

# --- Armazenamento de arquivos (imagens e vídeos dos pins) (a definir) ---
STORAGE_BUCKET=
STORAGE_TOKEN=

# --- Cobrança (a definir) ---
BILLING_PROVIDER=
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=

# Contas (cadastro/entrar)
# SESSION_SECRET também é usado para guardar o IP só como hash.
# AUTH_STORE=file  -> SOMENTE para teste local (npm run dev:local). Nunca na Vercel.
AUTH_STORE=
