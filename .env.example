# Variáveis de ambiente da plataforma.
# Na Vercel: Settings -> Environment Variables (produção). Nunca suba este arquivo preenchido.

# ---------- Obrigatórias para o sistema de contas funcionar ----------
# Banco Postgres (Neon, Supabase, Railway...). As tabelas são criadas sozinhas na primeira requisição.
DATABASE_URL=
# "disable" para um Postgres local sem TLS; "no-verify" se o provedor usar certificado próprio. Padrão: TLS verificado.
DATABASE_SSL=
# Segredo das sessões e dos hashes de IP (qualquer texto longo e aleatório, 32+ caracteres)
SESSION_SECRET=
# Chave que criptografa os tokens da Pinterest no banco: 32 bytes em base64 (openssl rand -base64 32) ou 64 caracteres hex
TOKEN_ENCRYPTION_KEY=
# Endereço público do site (usado no retorno do login da Pinterest e nos links dos e-mails)
APP_URL=https://pinflow-alpha.vercel.app

# ---------- Pinterest (developers.pinterest.com -> My apps) ----------
# Redirect URI a cadastrar no app da Pinterest:  <APP_URL>/api/pinterest/callback
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Opcional: escopos (padrão: boards:read boards:write pins:read pins:write user_accounts:read)
PINTEREST_SCOPES=
# Opcional: usar o sandbox da Pinterest em vez da API de verdade
# PINTEREST_API_BASE=https://api-sandbox.pinterest.com/v5

# ---------- Armazenamento de imagens e vídeos (Vercel Blob) ----------
# Criado em Vercel -> Storage -> Blob e conectado ao projeto; a Vercel preenche esta variável sozinha.
BLOB_READ_WRITE_TOKEN=

# ---------- E-mails (Resend) ----------
# Sem isso: esqueci a senha, confirmação de e-mail e avisos ficam desligados (as telas avisam).
RESEND_API_KEY=
MAIL_FROM="Pinflow <no-reply@seudominio.com.br>"

# ---------- Fila de publicação ----------
# Segredo do cron diário da Vercel e de agendadores externos (/api/cron/queue?key=...)
CRON_SECRET=

# ---------- Só para testes na sua máquina (NUNCA na Vercel) ----------
# AUTH_STORE=file        banco em arquivo (.data/dev-db.json)
# MEDIA_STORE=file       mídia em pasta (.data/media)
# MAIL_STORE=memory      e-mails ficam em memória
